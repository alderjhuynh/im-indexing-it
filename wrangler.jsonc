{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auraea",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "CARD", "class_name": "Card" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Card"] }],

  "vars": {
    "DISCORD_CLIENT_ID": "1572026720486297631",
    "CARD_SIZE": "10",
    "HOLD_HOURS": "24"
  }
}